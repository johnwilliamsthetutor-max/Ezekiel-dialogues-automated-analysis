\cf2 But Leviticus 26 opens 
\f2 \uc0\u1488 \u1460 \u1501 \u1470 \u1489 \u1456 \u1468 \u1495 \u1467 \u1511 \u1465 \u1468 \u1514 \u1463 \u1497 
\f1  
