\f2 \cf2 \uc0\u1495 \u1462 \u1512 \u1462 \u1489 
\f1 \cf2  
\f2 \cf2 \uc0\u1502 \u1462 \u1500 \u1462 \u1498 \u1456 \u1470 \u1489 \u1464 \u1468 \u1489 \u1462 \u1500 
\f1 \cf2  
\f2 \cf2 \uc0\u1514 \u1456 \u1468 \u1489 \u1493 \u1465 \u1488 \u1462 \u1498 \u1464 
